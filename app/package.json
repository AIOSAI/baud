{
  "name": "baud",
  "private": true,
  "version": "0.5.0",
  "license": "MIT",
  "type": "module",
  "description": "BAUD - the AIPass desktop: read-only fleet monitor + the operator's terminal",
  "scripts": {
    "tokens": "node src/tokens/generate.mjs",
    "dev": "npm run tokens && vite",
    "build": "npm run tokens && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:phone": "npm run tokens && vite --config vite.config.phone.ts",
    "build:phone": "npm run tokens && tsc && vite build --config vite.config.phone.ts",
    "test": "vitest run --dir src"
  },
  "dependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "dompurify": "3.4.17",
    "marked": "18.1.1",
    "react": "^19.3.1",
    "react-diff-view": "^3.3.3",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
