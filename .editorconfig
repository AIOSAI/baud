root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8

[*.py]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{json,yml,yaml,toml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.rs]
indent_style = space
indent_size = 4

[*.{ts,tsx,css}]
indent_style = space
indent_size = 2

[Cargo.toml]
indent_style = space
indent_size = 4

[*.json]
indent_style = space
indent_size = 2
