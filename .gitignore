# OS
.DS_Store
Thumbs.db

# Archives
.archive/

# Disabled files
*(disabled)*

# Registry lock
.*_REGISTRY.lock
.ai_central/deletions.jsonl

# Runtime state written by a branch at work - never source, never reviewable.
# .backup/ is the memory rollover's own safety copy, .chroma/ the vector store's
# sqlite. Both are regenerated from the live system; a committed one is a stale
# lie about what the branch remembers. dropbox/ is inbound handoffs from other
# branches; what is kept from one is copied into the tree and committed there.
.backup/
.chroma/
dropbox/

# Local secrets and scratch - never source. The host API's token receipts land
# in ~/.secrets by default, but `issue-token --out FILE` can put one anywhere,
# and a receipt is a live credential. docs.local/ is the AIPass scratch
# convention, untracked by design.
.env
.env.*
*.token
docs.local/
